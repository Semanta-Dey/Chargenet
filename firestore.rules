rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user has admin role in 'users' collection
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Stations Rules
    match /stations/{stationId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if request.auth != null && (
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availablePorts', 'occupiedPorts'])
      );
    }

    // Bookings Rules
    match /bookings/{bookingId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null;
      // Users can update their own bookings to transition states like 'charging' or 'completed'
      allow update: if request.auth != null && (
        isAdmin() || 
        (resource.data.userId == request.auth.uid && request.resource.data.status in ['charging', 'completed'])
      );
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Users Rules
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
